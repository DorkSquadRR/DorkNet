# DorkNet Cloudflare Tunnel config
# ────────────────────────────────────────────────────────────────────
# Routes only DorkNet's known localhost service subdomains through the
# tunnel into the local server (HTTPS on port 443). Generated by tools/setup-cloudflared.ps1
# — copy to %USERPROFILE%\.cloudflared\config.yml and replace the
# {{TUNNEL_ID}} / {{CREDENTIALS_FILE}} placeholders.
#
# Origin TLS verify is OFF because the local server's wildcard cert is
# from mkcert (a private CA trusted only on this machine). cloudflared
# would reject it as untrusted otherwise. Traffic between cloudflared
# and Cloudflare's edge is still TLS-encrypted; this only relaxes the
# leg from cloudflared → localhost.

tunnel: {{TUNNEL_ID}}
credentials-file: {{CREDENTIALS_FILE}}

originRequest:
  noTLSVerify: true

# Ingress rules are evaluated top-down. Keep this list aligned with
# DorkNetRouteOwnership.PublicSubdomains and ConfigService.ServiceSubdomains.
# Do not use *.localhost here: only the subdomains the client actually
# needs should reach the gateway/server.
ingress:
  - hostname: localhost
    service: https://localhost:443
    originRequest:
      httpHostHeader: localhost

  - hostname: admin.localhost
    service: https://localhost:443
  - hostname: api.localhost
    service: https://localhost:443
  - hostname: accounts.localhost
    service: https://localhost:443
  - hostname: auth.localhost
