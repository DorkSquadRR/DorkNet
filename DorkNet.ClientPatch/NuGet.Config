<?xml version="1.0" encoding="utf-8"?>
<!--
  BepInEx 6.x bleeding-edge packages live on the BepInEx NuGet
  feed, not nuget.org. Restore is scoped to this folder only so
  the project's package references resolve cleanly without polluting
  the global feed list.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"      value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx-NuGet"  value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
