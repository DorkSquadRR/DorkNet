<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DorkNet.DebugMod — the opt-in debugging companion to DorkNet.ClientMod.

    The shipping ClientMod carries ONLY the patches needed to connect and
    survive anti-cheat. ALL of the verbose diagnostic/tracing code (HTTP
    tracing, join/quit/studio/room-load traces, the process-exception sink,
    auth-token tracing, the registration-dialog trace, the in-game
    DebugConsole enable path) lives in THIS mod. Drop this dll into the
    Mods folder next to DorkNet.ClientMod.dll to debug; remove it to ship a
    quiet, minimal client.

    Fully self-contained: its own Harmony instance + its own copy of the
    reflection/patch helpers, so it never couples to ClientMod at load time.
    Debug knobs are read from the same UserData\dorknet-clientmod.json.

    Build:  dotnet build DorkNet.DebugMod/DorkNet.DebugMod.csproj -c Release
  -->

  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>DorkNet.DebugMod</RootNamespace>
    <AssemblyName>DorkNet.DebugMod</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS8602;CS8604;CS0436</NoWarn>
  </PropertyGroup>

  <!-- Reuse the MelonLoader the ClientMod build already downloads. -->
  <PropertyGroup>
    <MelonLoaderDir Condition="'$(MelonLoaderDir)' == ''">$(MSBuildThisFileDirectory)..\DorkNet.ClientMod\build\melonloader\MelonLoader\net6</MelonLoaderDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonLoaderDir)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
